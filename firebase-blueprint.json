{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Sajgoj Fashion catalog product document (document ID stored in path)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "colors": { "type": "array" },
        "sizes": { "type": "array" },
        "ageGroups": { "type": "array" },
        "stockUpdatedAt": { "type": "number" },
        "lastSyncSource": { "type": "string" },
        "isHotSale": { "type": "boolean" },
        "isBestDeal": { "type": "boolean" },
        "isB2G1": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "regularPrice": { "type": "number" },
        "offerPrice": { "type": "number" },
        "videoEnabled": { "type": "boolean" },
        "videoType": { "type": "string" },
        "videoUrl": { "type": "string" },
        "videoThumbUrl": { "type": "string" },
        "additionalImages": { "type": "array" },
        "brand": { "type": "string" },
        "attributes": { "type": "object" },
        "isAvailable": { "type": "boolean" },
        "isDraft": { "type": "boolean" },
        "specialPriceEnabled": { "type": "boolean" },
        "specialPriceStart": { "type": "string" },
        "specialPriceEnd": { "type": "string" },
        "shippingWeightKg": { "type": "string" },
        "shippingDimensions": { "type": "string" },
        "shippingDangerousGoods": { "type": "string" },
        "shippingExpressChandpur": { "type": "boolean" },
        "shippingNote": { "type": "string" },
        "warrantyType": { "type": "string" },
        "warrantyPeriod": { "type": "string" },
        "warrantyPolicy": { "type": "string" },
        "highlights": { "type": "array" },
        "enabledForWeb": { "type": "boolean" },
        "enabledForPos": { "type": "boolean" },
        "bogo": { "type": "boolean" },
        "bogoText": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["name", "price", "stock", "category", "updatedAt"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Authenticated customer review for a Sajgoj product",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "productId", "customerName", "rating", "comment", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Authenticated customer or POS order with strict owner/admin PII isolation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customer": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "district": { "type": "string" },
        "thana": { "type": "string" },
        "address": { "type": "string" },
        "landmark": { "type": "string" },
        "addressCategory": { "type": "string", "enum": ["Home", "Office"] },
        "defaultShippingAddress": { "type": "boolean" },
        "orderType": { "type": "string", "enum": ["Normal", "Custom"] },
        "deliveryType": { "type": "string", "enum": ["Standard", "Express"] },
        "deliveredBy": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "To Ship", "Shipped", "Shipping", "Delivered", "Failed Delivered", "Cancelled", "Cancellation"] },
        "date": { "type": "string" },
        "trackingId": { "type": "string" },
        "stockRestockedOnCancel": { "type": "boolean" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "customer", "phone", "items", "total", "status", "createdAt", "updatedAt"]
    },
    "ReturnRecord": {
      "title": "ReturnRecord",
      "description": "Admin-managed return and exchange memo record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderId": { "type": "string" },
        "customer": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "returnedItems": { "type": "array" },
        "isExchange": { "type": "boolean" },
        "exchangeItems": { "type": "array" },
        "totalReturnValue": { "type": "number" },
        "totalExchangeValue": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "priceDifference": { "type": "number" },
        "differenceType": { "type": "string" },
        "settlementMethod": { "type": "string" },
        "settlementTrxId": { "type": "string" },
        "settlementStatus": { "type": "string" },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "orderId", "customerName", "phone", "totalReturnValue", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "type": { "type": "string" },
        "parentId": { "type": "string" },
        "badge": { "type": "string" },
        "showInSlider": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Store settings and configuration document",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "announcementText": { "type": "string" }
      }
    },
    "PosInventoryItem": {
      "title": "PosInventoryItem",
      "description": "POS inventory mirror synchronized bidirectionally with storefront products",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "stock": { "type": "number" },
        "price": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastSource": { "type": "string" },
        "lastOrigin": { "type": "string" },
        "lastReferenceId": { "type": "string" }
      },
      "required": ["productId", "stock", "updatedAt"]
    },
    "InventorySyncEvent": {
      "title": "InventorySyncEvent",
      "description": "Immutable real-time bidirectional stock sync audit event",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "sku": { "type": "string" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "delta": { "type": "number" },
        "source": { "type": "string" },
        "reason": { "type": "string" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["productId", "previousStock", "newStock", "source", "timestamp"]
    },
    "SmsQueueItem": {
      "title": "SmsQueueItem",
      "description": "Admin-only SMS gateway queue item synchronized between Web Admin and Personal Android SIM Gateway",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "customerName": { "type": "string" },
        "message": { "type": "string" },
        "orderId": { "type": "string" },
        "type": { "type": "string", "enum": ["order_alert", "status_update", "bulk_promo", "custom"] },
        "status": { "type": "string", "enum": ["pending", "sending", "sent", "failed", "cancelled"] },
        "channel": { "type": "string", "enum": ["sim_gateway", "intent_manual"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "sentAt": { "type": "number" },
        "sentByDevice": { "type": "string" },
        "errorReason": { "type": "string" }
      },
      "required": ["phone", "message", "status", "createdAt", "updatedAt"]
    },
    "SupportChatThread": {
      "title": "SupportChatThread",
      "description": "Real-time customer support conversation thread keyed by customer UID",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhotoUrl": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastSenderRole": { "type": "string", "enum": ["customer", "admin"] },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "unreadByAdmin": { "type": "number" },
        "unreadByCustomer": { "type": "number" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "customerName", "lastMessage", "lastSenderRole", "status", "unreadByAdmin", "unreadByCustomer", "createdAt", "updatedAt"]
    },
    "SupportChatMessage": {
      "title": "SupportChatMessage",
      "description": "Individual message inside a customer support chat thread",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["customer", "admin"] },
        "text": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "OrderStatusNotification": {
      "title": "OrderStatusNotification",
      "description": "Real-time order status change notification dispatched to customer inbox and FCM",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderId": { "type": "string" },
        "customerName": { "type": "string" },
        "previousStatus": { "type": "string" },
        "newStatus": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "To Ship", "Shipped", "Shipping", "Delivered", "Failed Delivered", "Cancelled", "Cancellation"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "trackingId": { "type": "string" },
        "deliveredBy": { "type": "string" },
        "channel": { "type": "string", "enum": ["in_app", "fcm", "firestore"] },
        "read": { "type": "boolean" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "orderId", "previousStatus", "newStatus", "title", "message", "read", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "E-commerce product catalog collection (public read, verified admin write)"
    },
    "/reviews/{reviewId}": {
      "schema": "ProductReview",
      "description": "Product customer reviews (public read, signed-in user create/manage own, admin manage)"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer & POS orders (owner/admin read, signed-in create, admin status/courier update)"
    },
    "/returns/{returnId}": {
      "schema": "ReturnRecord",
      "description": "Return and exchange records (admin read and write)"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories collection (public read, admin write)"
    },
    "/config/{configDoc}": {
      "schema": "StoreConfig",
      "description": "Storefront configuration documents (store public read, secrets admin-only)"
    },
    "/pos_inventory/{productId}": {
      "schema": "PosInventoryItem",
      "description": "Real-time POS inventory mirror (admin read and write)"
    },
    "/inventory_sync_events/{eventId}": {
      "schema": "InventorySyncEvent",
      "description": "Immutable inventory bidirectional sync audit log (admin read and create)"
    },
    "/sms_queue/{smsId}": {
      "schema": "SmsQueueItem",
      "description": "Admin-only SMS queue for Personal Android SIM Gateway and 1-click SMS logs"
    },
    "/support_chats/{chatId}": {
      "schema": "SupportChatThread",
      "description": "Real-time customer support threads (customer owner or verified admin)"
    },
    "/support_chats/{chatId}/messages/{messageId}": {
      "schema": "SupportChatMessage",
      "description": "Real-time support chat messages subcollection (customer owner or verified admin)"
    },
    "/order_notifications/{notifId}": {
      "schema": "OrderStatusNotification",
      "description": "Automated order status alerts readable by the order owner or verified admin"
    }
  }
}
