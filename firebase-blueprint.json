{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Sajgoj Fashion product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sku": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customer": { "type": "string" },
        "phone": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "customer", "phone", "total"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Store settings and configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "tagline": { "type": "string" }
      }
    },
    "PosInventoryItem": {
      "title": "PosInventoryItem",
      "description": "POS inventory mirror synchronized bidirectionally with storefront products",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "stock": { "type": "number" },
        "price": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastSource": { "type": "string" },
        "lastReferenceId": { "type": "string" }
      },
      "required": ["productId", "stock", "updatedAt"]
    },
    "InventorySyncEvent": {
      "title": "InventorySyncEvent",
      "description": "Real-time bidirectional stock sync audit event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "sku": { "type": "string" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "delta": { "type": "number" },
        "source": { "type": "string" },
        "reason": { "type": "string" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "productId", "previousStock", "newStock", "source", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "E-commerce product collection"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders collection"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories collection"
    },
    "/config/{configDoc}": {
      "schema": "StoreConfig",
      "description": "Configuration documents"
    },
    "/pos_inventory/{productId}": {
      "schema": "PosInventoryItem",
      "description": "Real-time POS inventory mirror"
    },
    "/inventory_sync_events/{eventId}": {
      "schema": "InventorySyncEvent",
      "description": "Inventory bidirectional sync audit log"
    }
  }
}
